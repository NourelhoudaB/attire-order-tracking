{
  "name": "tenue-pro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts --host 0.0.0.0",
    "build": "vite build --config apps/web/vite.config.ts && esbuild apps/api/index.ts --bundle --platform=node --format=esm --packages=external --outfile=netlify/server/index.mjs",
    "db:generate": "drizzle-kit generate",
    "seed": "tsx scripts/seed.ts",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/swagger": "^9.9.3",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@netlify/blobs": "^11.1.9",
    "@netlify/database": "^2.0.3",
    "@netlify/functions": "^6.1.1",
    "@netlify/identity": "^2.0.1",
    "@netlify/server": "^0.1.6",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@tanstack/react-query": "^5.107.1",
    "argon2": "^0.45.2",
    "csv-parse": "^7.0.3",
    "drizzle-orm": "^1.0.0-beta.22",
    "fastify": "^5.12.8",
    "lucide-react": "^1.72.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5",
