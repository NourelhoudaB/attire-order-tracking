    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "drizzle-kit": "^1.0.0-beta.22",
    "esbuild": "^0.28.2",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^6.4.6",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "^5.1.0"
